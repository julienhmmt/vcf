{
  "name": "vaultcredsfiller",
  "version": "0.0.0",
  "description": "Autofill credentials from HashiCorp Vault and OpenBao",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:test-page": "python3 -m http.server 8080 --directory dev/test-page",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "pretest:e2e": "node test/e2e/build-fixture.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "postinstall": "wxt prepare"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.3",
    "@vitest/coverage-v8": "^5.0.1",
    "@wxt-dev/module-svelte": "^2.0.5",
    "jsdom": "^30.0.1",
    "svelte": "^5.57.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "tldts": "^7.4.13"
  },
  "type": "module"
}
